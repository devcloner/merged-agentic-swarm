{
  "version": 1,
  "description": "Provider registry for the merged agentic swarm — mirrors routes defined in providers/multi_provider_fabric.py. litellm on localhost:4000 is the primary backend.",
  "tiers": {
    "deep": [
      "opencode_go/deepseek-v4-flash",
      "gemini-2.5-pro",
      "codestral-latest"
    ],
    "main": [
      "opencode_go/deepseek-v4-flash",
      "gemini-2.5-flash",
      "llama-3.3-70b-versatile",
      "mistral-large-latest"
    ],
    "fast": [
      "opencode_go/deepseek-4-flash",
      "gemini-2.5-flash-lite",
      "qwen3.6-flash"
    ]
  },
  "policy": {
    "default_tier_by_role": {
      "cc-orchestrator": "deep",
      "tm-operator": "main",
      "spawn-gate": "main",
      "prd-decomposer": "deep",
      "spec-gap-detector": "main",
      "budget-route-auditor": "fast",
      "domain-module-worker": "main",
      "type-hardening-worker": "fast",
      "test-engineer": "main",
      "sec-a11y-auditor": "deep",
      "codebase-ast-mapper": "main"
    },
    "fallback_order": ["main", "fast", "deep"],
    "degrade_on_rate_limit": true,
    "degrade_on_budget_pressure": true
  },
  "role_routing": {
    "provider": "litellm",
    "default": "smart-auto",
    "tiers": {
      "deep": "gemini-batch",
      "main": "gemini-batch-lite",
      "fast": "fast-flash"
    },
    "roles": {
      "cc-orchestrator": "gemini-batch",
      "tm-operator": "gemini-batch-lite",
      "spawn-gate": "gemini-batch-lite",
      "prd-decomposer": "gemini-batch",
      "spec-gap-detector": "gemini-batch-lite",
      "budget-route-auditor": "fast-flash",
      "domain-module-worker": "gemini-batch-lite",
      "type-hardening-worker": "fast-flash",
      "test-engineer": "gemini-batch-lite",
      "sec-a11y-auditor": "gemini-batch",
      "codebase-ast-mapper": "gemini-batch-lite"
    },
    "notes": "Sub-agent role routing: maps worker roles/tiers to litellm virtual Gemini aliases on 127.0.0.1:4000 (aliases verified live via /v1/models on 2026-08-06). Tier aliases are primary; per-role aliases mirror policy.default_tier_by_role. Unknown roles resolve to the default (smart-auto)."
  },
  "backends": {
    "litellm": {
      "type": "openai_compatible",
      "base_url": "http://localhost:4000/v1/chat/completions",
      "auth_env": "LITELLM_PROXY_KEY",
      "status": "available",
      "primary": true,
      "notes": "Fronts a 42-key rotating Gemini pool as virtual models (gemini-2.5-flash, gemini-3.6-flash, gemini-batch, ...)"
    },
    "opencode": {
      "type": "openai_compatible",
      "base_url": "https://api.opencode.ai/v1/chat/completions",
      "auth_env": "OPENCODE_API_KEY",
      "status": "unavailable",
      "notes": "Status derived from OPENCODE_API_KEY presence in os.environ — currently unset"
    },
    "gemini": {
      "type": "openai_compatible",
      "base_url": "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions",
      "auth_env": "GEMINI_API_KEY",
      "status": "available"
    },
    "groq": {
      "type": "openai_compatible",
      "base_url": "https://api.groq.com/openai/v1/chat/completions",
      "auth_env": "GROQ_API_KEY",
      "status": "available"
    },
    "mistral": {
      "type": "openai_compatible",
      "base_url": "https://api.mistral.ai/v1/chat/completions",
      "auth_env": "MISTRAL_API_KEY",
      "status": "available"
    },
    "openrouter": {
      "type": "openai_compatible",
      "base_url": "https://openrouter.ai/api/v1/chat/completions",
      "auth_env": "OPENROUTER_API_KEY",
      "status": "available"
    },
    "alibabacloud": {
      "type": "openai_compatible",
      "base_url": "https://ws-os3nbzniaeck95yo.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1/chat/completions",
      "auth_env": "ALIBABACLOUD_API_KEY",
      "status": "available"
    },
    "digitalocean": {
      "type": "openai_compatible",
      "base_url": "https://inference.do-ai.run/v1/chat/completions",
      "auth_env": "DO_API_KEY",
      "status": "available"
    },
    "amazonaws": {
      "type": "aws_bedrock",
      "base_url": "https://bedrock-runtime.us-east-1.amazonaws.com/model/invoke",
      "auth_env": "AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY",
      "auth_method": "sigv4",
      "status": "misconfigured"
    },
    "nvidia_nim": {
      "type": "openai_compatible",
      "base_url": "https://integrate.api.nvidia.com/v1/chat/completions",
      "auth_env": "NVIDIA_NIM_API_KEY",
      "status": "available"
    },
    "fcc-proxy": {
      "type": "anthropic_compatible",
      "base_url": "http://127.0.0.1:8080/v1/messages",
      "auth_env": "ANTHROPIC_AUTH_TOKEN",
      "status": "available",
      "notes": "Anthropic Messages API shape; key_pool falls back to 'freecc' when ANTHROPIC_AUTH_TOKEN is unset"
    },
    "routatic-proxy": {
      "type": "anthropic_compatible",
      "base_url": "http://127.0.0.1:3456/v1/messages",
      "auth_env": "ANTHROPIC_AUTH_TOKEN",
      "status": "available",
      "notes": "Anthropic-wire only — OpenAI /v1/chat/completions returns 404"
    },
    "cloudcli": {
      "type": "remote_agent",
      "base_url": "https://cloneclove.com/api/agent",
      "auth_env": "CLOUDCLI_API_KEY",
      "status": "available",
      "notes": "Agent-triggering API (POST /api/agent, X-API-Key header), not a chat-completions endpoint"
    },
    "bluesminds": {
      "type": "openai_compatible",
      "base_url": "https://api.bluesminds.com/v1",
      "auth_env": "BLUESMINDS_API_KEY",
      "status": "available",
      "notes": "Bypasses the litellm gateway (direct api.bluesminds.com); key embedded inline in ~/opencode.json"
    },
    "bluesminds-k1": {
      "type": "openai_compatible",
      "base_url": "https://api.bluesminds.com/v1",
      "auth_env": "BLUESMINDS_K1_API_KEY",
      "status": "available",
      "notes": "K1/claude-* models on a separate K1 key; also bypasses the gateway"
    }
  },
  "notes": [
    "litellm on http://localhost:4000 is the PRIMARY backend — a local gateway that fronts a 42-key rotating Gemini pool as virtual models",
    "Real routing table defined in providers/multi_provider_fabric.py MODEL_FABRIC_ROUTES",
    "fcc-server on port 8080 handles ANTHROPIC_BASE_URL traffic via settings.local.json",
    "Python proxy on port 8085 provides Anthropic + OpenAI compatible endpoints with key-pool rotation",
    "bluesminds and bluesminds-k1 point directly at https://api.bluesminds.com/v1, bypassing the litellm gateway entirely — no rate-limit/K1 routing, K1 spend untracked by the gateway",
    "routatic-proxy on port 3456 is Anthropic-wire only; OpenAI /v1/chat/completions 404s there",
    "Multi-provider fabric falls back to offline simulation payload when all keys are exhausted"
  ]
}
